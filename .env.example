APP_ENV=development
HTTP_ADDR=:8080
ALLOWED_ORIGIN=http://localhost:5173
DATABASE_PATH=data/internship-tracker.db
MIGRATIONS_PATH=migrations
CANDIDATE_PROFILE_PATH=configs/candidate-profile.json
SOURCES_PATH=configs/sources.json

LLM_PROVIDER=deterministic
LLM_MODEL=
OPENROUTER_API_KEY=
# Set exactly one of OPENROUTER_API_KEY and OPENROUTER_API_KEY_FILE.
OPENROUTER_API_KEY_FILE=
GEMINI_API_KEY=
# Set exactly one of GEMINI_API_KEY and GEMINI_API_KEY_FILE.
GEMINI_API_KEY_FILE=
LLM_THINKING_LEVEL=minimal
LLM_INPUT_COST_PER_MILLION_USD=0
LLM_OUTPUT_COST_PER_MILLION_USD=0

SCAN_SCHEDULE=0 9 * * 1
SCAN_TIMEZONE=Europe/Istanbul

# Development defaults do not create SQLite backup files. Production must set a
# private persistent BACKUP_DIRECTORY and explicitly enable this service.
BACKUP_ENABLED=false
BACKUP_DIRECTORY=
BACKUP_TIME=02:00
BACKUP_TIMEZONE=Europe/Istanbul
BACKUP_RETENTION=7
WEB_PUSH_ENABLED=false
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Set exactly one of WEB_PUSH_PRIVATE_KEY and WEB_PUSH_PRIVATE_KEY_FILE.
WEB_PUSH_PRIVATE_KEY_FILE=
WEB_PUSH_SUBJECT=
